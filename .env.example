# MARKET_LENS_FRESHNESS_SOURCE=disconnected
# MARKET_LENS_ALERTS_SOURCE=disconnected
# MARKET_LENS_SCREENER_SOURCE=disconnected
# MARKET_LENS_OHLCV_SOURCE=disconnected
# MARKET_LENS_STOCK_ANALYSIS_SOURCE=disconnected
# Evaluation remains disconnected until a published backend evaluation API is available.
MARKET_LENS_EVALUATION_SOURCE=disconnected
