# Local operator only. No remote URLs, LAN exposure or public deployment without an authenticated gateway.
# npm run dev / npm run start bind to 127.0.0.1 by default.
MARKET_LENS_DATA_SOURCE=mock
DONGHAK_API_BASE_URL=http://127.0.0.1:8000
MARKET_LENS_URL=http://127.0.0.1:3000
# HTTP mode also enables supported Operations, OHLCV, Screener and Stock Analysis adapters.
# Optional per-feature overrides: http | disconnected | mock (mock is fictional data).
# MARKET_LENS_OPERATIONS_SOURCE=disconnected
# MARKET_LENS_FRESHNESS_SOURCE=disconnected
# MARKET_LENS_ALERTS_SOURCE=disconnected
# MARKET_LENS_SCREENER_SOURCE=disconnected
# MARKET_LENS_OHLCV_SOURCE=disconnected
# MARKET_LENS_STOCK_ANALYSIS_SOURCE=disconnected
# Evaluation remains disconnected until a published backend evaluation API is available.
MARKET_LENS_EVALUATION_SOURCE=disconnected

# Optional read-only research LLM control-plane observer.
# Both values are server-only. Never prefix the token with NEXT_PUBLIC_.
# Only an explicitly approved 127.0.0.1 endpoint is accepted; no browser proxy is exposed.
# DONGHAK_AI_MANAGEMENT_BASE_URL=http://127.0.0.1:8001/
# DONGHAK_AI_MANAGEMENT_TOKEN=your-existing-ai-read-scoped-token

# Independent actual research publication; disabled by default unless explicitly enabled.
# MARKET_LENS_DAILY_RESEARCH_SOURCE=http
# MARKET_LENS_VERIFY_TICKER=005930
# Read-only verification after local backend startup:
# npm run verify:research:workspace
# Model-control management verification is optional; it requires the two
# DONGHAK_AI_MANAGEMENT_* server-only variables above and only uses GET.

# Optional autonomous experiment publication, separate from Daily Research (HTTP 503).
# Run npm run verify:autonomous:export once from the operator Mac; it reads local
# KRX-Private/Research/*/experiments.sqlite3 without changing the source DBs.
# Publication stays at ~/Library/Application Support/TrisMarketLens/
# autonomous-research-publication.json (0600). Not available over an HTTP API.
# MARKET_LENS_AUTONOMOUS_RESEARCH_SOURCE=local_snapshot
