{
  "name": "tris-market-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:http": "node --env-file=.env.local scripts/verify-http.mjs",
    "verify:extensions": "node --env-file=.env.local scripts/verify-extensions-http.mjs",
    "verify:scripts": "node --check scripts/verify-http.mjs && node --check scripts/verify-extensions-http.mjs && node --check scripts/create-verification-report.mjs",
    "verify:report": "node scripts/create-verification-report.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
